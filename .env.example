# Copie este archivo a .env y complete SOLO si quiere leer la base de datos en vivo.
# Si no hay conexión configurada, el dashboard usa los CSV de la carpeta data/.

# Opción 1 (Supabase / cualquier PostgreSQL):
# DATABASE_URL=postgresql://usuario:clave@host:5432/postgres

# Opción 2 (PostgreSQL local):
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=el_buen_sabor
# PGUSER=postgres
# PGPASSWORD=su_clave
